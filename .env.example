# Copy to .env and fill in real values. NEVER commit .env.
#
# Local development uses the Docker Postgres service in docker-compose.yml.
# Start it first:  docker compose up -d   (then: pnpm dev)
#
# Production (Vercel) requires a managed Postgres — use a Neon POOLED
# connection string here instead. No code change is needed to switch;
# only this value differs between environments.

# Postgres connection (local Docker default shown as a placeholder)
DATABASE_URI=postgres://attendance:attendance@localhost:5432/attendance_dev

# Payload auth/encryption secret — generate your own (e.g. openssl rand -hex 32)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public base URL of the app. Also the CSRF allowlist origin for cookie auth:
# required in production (the app refuses to start without it).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional extra trusted origins for cookie auth, comma-separated
# (e.g. a preview deployment URL). Leave empty normally.
CSRF_ALLOWED_ORIGINS=

# --- Student photo storage (S3-compatible) -----------------------------------
# Leave ALL of these unset → photos go to local disk (media/student-photos), dev only.
# Set S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY (+ S3_ENDPOINT /
# S3_FORCE_PATH_STYLE as needed) → photos go to the bucket. Setting only some of the
# required four makes the app refuse to start.
# The bucket MUST be private in every environment: no public access, no public
# ACL/policy, no public dev URL. Photos are served only through the app, which
# checks who may see them. Production (Vercel) must use a bucket — its disk is ephemeral.
#
# Local SeaweedFS (docker compose up -d seaweedfs seaweedfs-init) — LOCAL DEV ONLY,
# these credentials are committed in docker/seaweedfs/s3.json:
# S3_BUCKET=student-photos-dev
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:8333
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=attendance-dev
# S3_SECRET_ACCESS_KEY=attendance-dev-only
#
# Cloudflare R2: S3_REGION=auto, S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
#   S3_FORCE_PATH_STYLE=false, keys from an R2 API token scoped to this bucket.
# AWS S3: S3_REGION=<bucket region>, leave S3_ENDPOINT empty, S3_FORCE_PATH_STYLE=false.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
