# Production env for docker-compose.prod.yml — PLACEHOLDERS ONLY.
#
#   cp deploy/.env.production.example deploy/.env.production
#   chmod 600 deploy/.env.production
#
# NEVER commit deploy/.env.production (it is gitignored). It exists only on the VPS.

# Public hostname, no scheme, no trailing slash. Used for the Caddy site address AND
# baked into the build as NEXT_PUBLIC_SERVER_URL=https://${APP_DOMAIN}
# → changing it requires a rebuild.
APP_DOMAIN=attendance.example.ac.th

# Let's Encrypt account email (expiry notices).
ACME_EMAIL=admin@example.ac.th

# Postgres. Password MUST be hex (openssl rand -hex 24) — DATABASE_URI is assembled
# in compose without URL-encoding.
POSTGRES_USER=mtyk
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24
POSTGRES_DB=mtyk

# Payload auth/encryption secret: openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME_openssl_rand_hex_32

# Extra trusted origins for cookie auth (comma-separated). Leave empty.
CSRF_ALLOWED_ORIGINS=

# Student photos are stored on the `media` volume (/app/media/student-photos).
# Every S3_* variable must stay UNSET here — setting only some of them stops the
# app from starting, and setting all of them moves photos to a bucket.
